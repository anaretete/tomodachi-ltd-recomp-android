<?xml version="1.0" encoding="utf-8"?>
<!-- ==============================================================================
     android/app/src/main/AndroidManifest.xml
     Android Application Manifest for tomodachi-ltd-recomp
     ============================================================================== -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hardware Capabilities: Vulkan, Touchscreen, Gamepad -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400000"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tomodachi.Fullscreen"
        android:extractNativeLibs="true">

        <!-- 1. Dedicated Startup & Asset Management Activity (Always shows UI on launch) -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|navigation"
            android:screenOrientation="sensorLandscape"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTop"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Native Engine Activity (Invoked by Launcher when user starts game or test) -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|navigation"
            android:screenOrientation="sensorLandscape"
            android:alwaysRetainTaskState="true"
            android:exported="false">

            <!-- Shared library name loaded by NativeActivity (libtomodachi_app.so) -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="tomodachi_app" />
        </activity>

        <!-- Backwards-compatibility alias for older links -->
        <activity
            android:name=".TomodachiActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|navigation"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

    </application>

</manifest>
